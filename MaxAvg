
public class MaxAvg {

    public static double findMax(int arr[], int k) {

        int sum = 0;
        for (int i = 0; i < k; i++) {
            sum += arr[i];
        }

        int maxsum = sum;
        int start = 0;
        int end = k;
        while (end < arr.length) {
            sum -= arr[start];
            start++;

            sum += arr[end];
            end++;

            maxsum = Math.max(maxsum, sum);
        }
        return (double) maxsum / k;
    }

    public static void main(String[] args) {
        int arr[] = {1, 12, -5, -6, 50, 3};
        int k = 4;
        System.out.println(findMax(arr, k));
    }
}
