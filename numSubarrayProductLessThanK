class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {
        if(k<=1){
            return 0;
        }
        long prefix[]=new long[nums.length+1];
        prefix[0]=1;
        for(int i=0;i<nums.length;i++){
            prefix[i+1]=prefix[i] *nums[i];
        }
        int count=0;
        for(int i=0;i<nums.length;i++){
            for(int j=i;j<nums.length;j++){
             long product = prefix[j + 1] / prefix[i];
                if(product<k){
                    count++;
                    
                }
            }
        }
        return count;
    }
}
